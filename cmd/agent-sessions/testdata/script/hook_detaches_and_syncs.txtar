# The hook returns at once and prints nothing; a detached sync uploads the session afterwards.
age 3600 home/.pi/agent/sessions/--w--/2026-10-10T10-00-00-000Z_s1.jsonl
exec agent-sessions hook pi --path $WORK/home/.pi/agent/sessions/--w--/2026-10-10T10-00-00-000Z_s1.jsonl
! stdout .
! stderr .
waitfor bucket/v3/machines/testbox/records/file/a4a2af754d75015c1ae28b83f1db04122f945a238589231f9f47165d2a52c105/commits/00000000000000000001-*.json
waitfor bucket/v3/machines/testbox/records/manifest/b09f15326717aef9952cf34e009e21fb0258a5f2c30e717a4fed7abc8b8dc66c/commits/00000000000000000001-*.json
# Commit discovery uses SHA256(agent NUL logical key), not mutable file objects.
# The debounce marker is gone once the sync has started reading.
! waitfor state/pending/[0-9a-f]*

# Disabled: nothing happens.
env AGENT_SESSIONS_DISABLE=1
exec agent-sessions hook pi --path $WORK/home/.pi/agent/sessions/--w--/other.jsonl
! stdout .
! stderr .

-- home/.pi/agent/sessions/--w--/2026-10-10T10-00-00-000Z_s1.jsonl --
{"type":"session","version":3,"id":"s1","cwd":"/nowhere"}
{"type":"message","id":"m1","message":{"role":"user","content":"hi"}}
