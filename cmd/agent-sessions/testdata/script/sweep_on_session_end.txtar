# A session's end also sweeps every agent's files, so a session no hook reported still reaches
# the bucket.
age 3600 home/.pi/agent/sessions/--w--/2026-10-10T10-00-00-000Z_crashed.jsonl
exec agent-sessions hook pi --path $WORK/home/.pi/agent/sessions/--w--/2026-10-10T11-00-00-000Z_ended.jsonl --event session_shutdown
! stdout .
! stderr .
waitfor bucket/raw/agent=pi/machine=testbox/sessions/--w--/2026-10-10T11-00-00-000Z_ended.jsonl.zst
waitfor bucket/raw/agent=pi/machine=testbox/sessions/--w--/2026-10-10T10-00-00-000Z_crashed.jsonl.zst
waitfor bucket/manifests/agent=pi/machine=testbox/2026-10-10T10-00-00-000Z_crashed.json
! waitfor state/pending/[0-9a-f]*
exec agent-sessions status
stdout 'sweep:session_shutdown'

-- home/.pi/agent/sessions/--w--/2026-10-10T10-00-00-000Z_crashed.jsonl --
{"type":"session","version":3,"id":"crashed","cwd":"/nowhere"}
{"type":"message","id":"m1","message":{"role":"user","content":"hi"}}
-- home/.pi/agent/sessions/--w--/2026-10-10T11-00-00-000Z_ended.jsonl --
{"type":"session","version":3,"id":"ended","cwd":"/nowhere"}
{"type":"message","id":"m1","message":{"role":"user","content":"bye"}}
