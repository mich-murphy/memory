+    parser = argparse.ArgumentParser(description=__doc__)
+    for name in ("bwrap", "run", "source", "assets", "modulecache", "gotoolchain"):
+        parser.add_argument("--" + name, type=existing, required=True)
+    for agent in ("claude", "codex", "pi"):
+        parser.add_argument("--" + agent, required=True,
+                            help="exact executable path relative to staged assets")
+    parser.add_argument("--runtime", type=existing, action="append", default=[],
+                        help="approved public Nix closure root or system library path; repeat")
+    args = parser.parse_args()
+    if sys.platform != "linux":
+        parser.error("Linux only; no fallback")
+    run = args.run
+    st = run.stat()
+    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid() or stat.S_IMODE(st.st_mode) != 0o700 or any(run.iterdir()):
+        parser.error("run must be an existing EMPTY owned 0700 directory")
+    for path in (args.source, args.assets, args.modulecache, args.gotoolchain, *args.runtime):
+        if path == run or run in path.parents or path in run.parents:
+            parser.error("public read-only inputs must not overlap owned run")
+    agents = {}
+    for agent in ("claude", "codex", "pi"):
+        relative = Path(getattr(args, agent))
+        if relative.is_absolute() or ".." in relative.parts:
