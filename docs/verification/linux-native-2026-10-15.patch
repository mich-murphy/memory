+package main
+
+import "testing"
+
+func TestLiveLinuxRoutesRejectExternalRoutes(t *testing.T) {
+	for _, tt := range []struct {
+		name string
+		path string
+		body string
+		ok   bool
+	}{
+		{"empty", "/proc/net/route", "Iface Destination Gateway Flags RefCnt Use Metric Mask MTU Window IRTT\n", true},
+		{"loopback4", "/proc/net/route", "lo 0000007F 00000000 0001 0 0 0 000000FF 0 0 0\n", true},
+		{"external4", "/proc/net/route", "eth0 00000000 0100000A 0003 0 0 0 00000000 0 0 0\n", false},
+		{"default4", "/proc/net/route", "lo 0000007F 00000000 0001 0 0 0 00000000 0 0 0\n", false},
+		{"loopback6", "/proc/net/ipv6_route", "00000000000000000000000000000001 80 00000000000000000000000000000000 00 00000000000000000000000000000000 00000000 00000000 00000000 80200001 lo\n", true},
+		{"unreachable6", "/proc/net/ipv6_route", "00000000000000000000000000000000 00 00000000000000000000000000000000 00 00000000000000000000000000000000 ffffffff 00000001 00000000 00200200 lo\n", true},
+		{"default6", "/proc/net/ipv6_route", "00000000000000000000000000000000 00 00000000000000000000000000000000 00 00000000000000000000000000000000 00000000 00000000 00000000 00000001 lo\n", false},
+		{"malformed", "/proc/net/ipv6_route", "lo\n", false},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			err := liveLinuxRoutes(tt.path, tt.body)
+			if (err == nil) != tt.ok {
+				t.Fatalf("route validation = %v, want accepted=%t", err, tt.ok)
+			}
+		})
+	}
+}
diff --git a/cmd/agent-sessions/live_boundary_test.go b/cmd/agent-sessions/live_boundary_test.go
new file mode 100644
index 0000000..c5b1d90
--- /dev/null
+++ b/cmd/agent-sessions/live_boundary_test.go
@@ -0,0 +1,281 @@
+package main
+
+// Private Linux acceptance fixture, not a general-purpose sandbox abstraction.
+// All Go (including TestMain), the model server, agents and detached hooks must
+// already be inside the operator's outer bubblewrap before this code is loaded.
+import (
+	"context"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"syscall"
+	"testing"
+	"time"
+)
+
+type liveLinuxFixture struct {
+	Marker     string            `json:"marker"`
+	Host       map[string]string `json:"host"`
+	Agents     map[string]string `json:"agents"`
+	CanarySHA  string            `json:"canary_sha256"`
+	Outside    string            `json:"outside"`
+	OutsideSHA string            `json:"outside_sha256"`
+}
+
+func liveReadLinuxProof() (liveLinuxFixture, error) {
+	var proof liveLinuxFixture
+	body, err := os.ReadFile("/proof/manifest.json")
+	if err != nil {
+		return proof, err
+	}
+	if err := json.Unmarshal(body, &proof); err != nil {
+		return proof, err
+	}
+	if proof.Marker != "private-bc01-linux-native-v1" || len(proof.Host) != 3 || len(proof.Agents) != 3 || len(proof.CanarySHA) != 64 || len(proof.OutsideSHA) != 64 || !strings.HasPrefix(proof.Outside, "/") || strings.Contains(proof.Outside, "..") || !strings.HasSuffix(proof.Outside, "/unmounted/canary") {
+		return proof, errors.New("missing or invalid private Linux launcher fixture")
+	}
+	for _, agent := range []string{"claude", "codex", "pi"} {
+		path := proof.Agents[agent]
+		if !strings.HasPrefix(path, "/assets/") || filepath.Clean(path) != path || (agent == "pi" && !strings.Contains(path, "/pi-coding-agent/")) {
+			return proof, fmt.Errorf("unreviewed %s executable path %q", agent, path)
+		}
+	}
+	return proof, nil
+}
+
+func liveLinuxNamespaces(proof liveLinuxFixture) (map[string]string, error) {
+	actual := map[string]string{}
+	for _, name := range []string{"net", "pid", "mnt"} {
+		id, err := os.Readlink("/proc/self/ns/" + name)
+		if err != nil {
+			return nil, err
+		}
+		if !strings.HasPrefix(proof.Host[name], name+":[") {
+			return nil, fmt.Errorf("missing host %s namespace identity", name)
+		}
+		if id == proof.Host[name] {
+			return nil, fmt.Errorf("%s namespace still equals host %s", name, id)
+		}
+		actual[name] = id
+	}
+	pid1, err := os.Readlink("/proc/1/ns/pid")
+	if err != nil {
+		return nil, err
+	}
+	if pid1 != actual["pid"] {
+		return nil, errors.New("proc was not mounted for the inner PID namespace")
+	}
+	return actual, nil
+}
+
+func liveLinuxProof(t *testing.T) liveLinuxFixture {
+	t.Helper()
+	proof, err := liveReadLinuxProof()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := liveLinuxNamespaces(proof); err != nil {
+		t.Fatal(err)
+	}
+	return proof
+}
+
+// Probe init deliberately precedes TestMain: this descendant must not start a
+// compiler. It is a real setsid child, not a simulated detached-hook result.
+func init() {
+	if os.Getenv("MEMORY_LIVE_LINUX_PROBE") != "1" {
+		return
+	}
+	proof, err := liveReadLinuxProof()
+	if err == nil {
+		err = liveProbeLinux(proof, os.Getenv("MEMORY_LIVE_PROBE_ROOT"), os.Getenv("MEMORY_LIVE_PROBE_URL"), os.Getenv("MEMORY_LIVE_PROBE_NAMESPACES"))
+	}
+	if err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+	os.Exit(0)
+}
+
+func liveVerifyLinux(t *testing.T, l liveRun, port string) {
+	t.Helper()
+	proof := liveLinuxProof(t)
+	actual, err := liveLinuxNamespaces(proof)
+	if err != nil {
+		t.Fatal(err)
+	}
+	namespaces, err := json.Marshal(actual)
+	if err != nil {
+		t.Fatal(err)
+	}
+	url := "http://127.0.0.1:" + port + "/health"
+	if err := liveProbeLinux(proof, l.root, url, string(namespaces)); err != nil {
+		t.Fatal(err)
+	}
+	executable, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(t.Context(), 10*time.Second)
+	defer cancel()
+	cmd := l.command(ctx, executable)
+	cmd.Env = append(cmd.Env, "MEMORY_LIVE_LINUX_PROBE=1", "MEMORY_LIVE_PROBE_ROOT="+l.root, "MEMORY_LIVE_PROBE_URL="+url, "MEMORY_LIVE_PROBE_NAMESPACES="+string(namespaces))
+	cmd.SysProcAttr = &syscall.SysProcAttr{Setsid: true}
+	out, err := cmd.CombinedOutput()
+	liveWrite(t, filepath.Join(l.root, "linux-setsid-preflight.output"), string(out), 0o600)
+	if err != nil {
+		t.Fatalf("setsid boundary probe: %v\n%s", err, out)
+	}
+	t.Logf("Linux preflight and setsid descendant passed: host=%v actual=%v; network is namespace-local, NOT macOS exact-port isolation", proof.Host, actual)
+}
+
+func liveProbeLinux(proof liveLinuxFixture, root, url, expected string) error {
+	actual, err := liveLinuxNamespaces(proof)
+	if err != nil {
+		return err
+	}
+	var inherited map[string]string
+	if err := json.Unmarshal([]byte(expected), &inherited); err != nil {
+		return err
+	}
+	for name, id := range actual {
+		if inherited[name] != id {
+			return fmt.Errorf("descendant changed %s namespace", name)
+		}
+	}
+	interfaces, err := net.Interfaces()
+	if err != nil {
+		return err
+	}
+	if len(interfaces) != 1 || interfaces[0].Name != "lo" || interfaces[0].Flags&(net.FlagLoopback|net.FlagUp) != net.FlagLoopback|net.FlagUp {
+		return fmt.Errorf("interfaces = %v, want only active loopback", interfaces)
+	}
+	addresses, err := interfaces[0].Addrs()
+	if err != nil {
+		return err
+	}
+	for _, address := range addresses {
+		ip, _, err := net.ParseCIDR(address.String())
+		if err != nil || !ip.IsLoopback() {
+			return fmt.Errorf("non-loopback interface address %v", address)
+		}
+	}
+	for _, path := range []string{"/proc/net/route", "/proc/net/ipv6_route"} {
+		body, err := os.ReadFile(path)
+		if err != nil {
+			return err
+		}
+		if err := liveLinuxRoutes(path, string(body)); err != nil {
+			return err
+		}
+		fmt.Printf("%s:\n%s\n", path, body)
+	}
+	// These are numeric documentation addresses: no DNS, curl, proxy, or timeout
+	// can stand in for the kernel's positive ENETUNREACH result.
+	for _, address := range []string{"192.0.2.1:443", "[2001:db8::1]:443"} {
+		conn, err := net.DialTimeout("tcp", address, time.Second)
+		if err == nil {
+			if err := conn.Close(); err != nil {
+				return err
+			}
+			return fmt.Errorf("external connection succeeded: %s", address)
+		}
+		if !errors.Is(err, syscall.ENETUNREACH) {
+			return fmt.Errorf("external %s: %w; want ENETUNREACH", address, err)
+		}
+		fmt.Printf("external %s: %v\n", address, err)
+	}
+	client := &http.Client{
+		Timeout:   3 * time.Second,
+		Transport: &http.Transport{Proxy: nil},
+		CheckRedirect: func(_ *http.Request, _ []*http.Request) error {
+			return errors.New("unexpected redirect")
+		},
+	}
+	defer client.CloseIdleConnections()
+	response, err := client.Get(url)
+	if err != nil {
+		return err
+	}
+	if err := response.Body.Close(); err != nil {
+		return err
+	}
+	if response.StatusCode != http.StatusOK {
+		return fmt.Errorf("loopback health = %d", response.StatusCode)
+	}
+	if !strings.HasPrefix(root, "/run/live/tmp/memory-live-") {
+		return fmt.Errorf("scratch outside owned mount: %q", root)
+	}
+	path := filepath.Join(root, "boundary-positive")
+	if err := os.WriteFile(path, []byte("scratch control\n"), 0o600); err != nil {
+		return err
+	}
+	body, err := os.ReadFile(path)
+	if err != nil || string(body) != "scratch control\n" {
+		return fmt.Errorf("scratch readback = %q: %v", body, err)
+	}
+	for path, want := range map[string]string{"/proof/canary": proof.CanarySHA, "/proof/manifest.json": ""} {
+		before, err := os.ReadFile(path)
+		if err != nil {
+			return err
+		}
+		if want != "" && liveDigest(before) != want {
+			return errors.New("read-only canary differs from launcher digest")
+		}
+		err = os.WriteFile(path, []byte("forbidden\n"), 0o600)
+		if !errors.Is(err, syscall.EROFS) && !errors.Is(err, os.ErrPermission) {
+			return fmt.Errorf("write %s = %v, want EROFS/permission", path, err)
+		}
+		after, err := os.ReadFile(path)
+		if err != nil {
+			return err
+		}
+		if liveDigest(before) != liveDigest(after) {
+			return errors.New("read-only fixture changed")
+		}
+		fmt.Printf("readonly %s: write denied; before=%s after=%s\n", path, liveDigest(before), liveDigest(after))
+	}
+	if _, err := os.ReadFile(proof.Outside); !errors.Is(err, os.ErrNotExist) && !errors.Is(err, os.ErrPermission) {
+		return fmt.Errorf("unmounted synthetic canary read = %v, want absent/permission", err)
+	}
+	fmt.Printf("boundary controls passed: namespaces=%v interfaces=%v addresses=%v\n", actual, interfaces, addresses)
+	return nil
+}
+
+func liveLinuxRoutes(path, body string) error {
+	for line := range strings.SplitSeq(strings.TrimSpace(body), "\n") {
+		fields := strings.Fields(line)
+		if len(fields) == 0 || fields[0] == "Iface" {
+			continue
+		}
+		if strings.HasSuffix(path, "ipv6_route") {
+			if len(fields) != 10 || fields[9] != "lo" || fields[4] != strings.Repeat("0", 32) {
+				return fmt.Errorf("unexpected IPv6 route: %s", line)
+			}
+			flags, err := strconv.ParseUint(fields[8], 16, 32)
+			if err != nil {
+				return err
+			}
+			address, err := hex.DecodeString(fields[0])
+			if err != nil {
+				return err
+			}
+			// Linux may expose namespace-local unreachable default entries on lo.
+			if flags&0x200 == 0 && (!net.IP(address).IsLoopback() || fields[1] != "80") {
+				return fmt.Errorf("non-loopback IPv6 route: %s", line)
+			}
+		} else {
+			if len(fields) != 11 || fields[0] != "lo" || !strings.HasSuffix(strings.ToUpper(fields[1]), "7F") || fields[2] != "00000000" || !strings.HasSuffix(strings.ToUpper(fields[7]), "FF") {
+				return fmt.Errorf("non-loopback IPv4 route: %s", line)
+			}
+		}
+	}
+	return nil
+}
