{
  "env": {
    "MCP_TIMEOUT": "180000"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true
  },
  "enabledMcpjsonServers": [
    "gopls"
  ],
  "permissions": {
    "deny": [
      "Edit(**/.golangci.yml)",
      "Edit(**/.testcoverage.yml)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(Edit|Write|MultiEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/go-check.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
